# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# All secrets are env-only — they must never appear in config.yaml (§8).

# ============================================================================
# Consumed by the application (PODAGENT_* prefix)
# ============================================================================

# --- Required ---------------------------------------------------------------
# OpenRouter is the primary provider for every tier in the shipped config.yaml.
# It is REQUIRED while there is no local model host — startup refuses to boot
# rather than silently failing over to an unauthenticated provider.
#
# It stops being required only when a tier's active chain no longer contains
# it: restore an Ollama primary and set `allow_cloud_fallback: false` for a
# fully local deployment, and the key is not read.
PODAGENT_OPENROUTER_API_KEY=

# --- Optional ---------------------------------------------------------------
# Only needed if notifications are enabled and your ntfy instance requires auth.
PODAGENT_NTFY_TOKEN=

# Path to the non-secret config file. The container sets this to
# /config/config.yaml; locally it defaults to ./config.yaml.
# PODAGENT_CONFIG_FILE=/config/config.yaml

# Any config.yaml value can be overridden with PODAGENT_<SECTION>__<KEY>:
# PODAGENT_PIPELINE__DIGEST_THRESHOLD=6
# PODAGENT_LOGGING__LEVEL=DEBUG

# Prefer an override here over editing the deployed config.yaml. Keeping that
# file byte-identical to the repo's is what stops it going quietly stale — the
# same failure scripts/make-local-config.py exists to prevent. The NAS uses this
# one, where large-v3-turbo does not fit alongside everything else on the box:
# PODAGENT_ASR__MODEL=small.en

# Where the weekly digest is read aloud, over the OpenAI speech API. This is
# deployment topology, so it lives here rather than in the console: on the Mac
# that is 127.0.0.1, from the NAS it is the Mac's LAN address. Setting it alone
# does nothing until text-to-speech is enabled on the Settings page.
# See RUNNING-ON-MAC.md for the Kokoro side.
# PODAGENT_TTS__BASE_URL=http://127.0.0.1:8880

# Projecting digests into an Obsidian vault over Self-hosted LiveSync. This is
# the CouchDB your *vault* replicates against, which is a different database
# from this app's own (COUCHDB_* below) and very likely owned by a different
# application — so it gets its own address, user and password. Nothing is
# projected until vault.enabled is true in config.yaml.
#
# The plugin must have end-to-end encryption and path obfuscation OFF: the
# projection writes plaintext chunks keyed by vault path.
# PODAGENT_VAULT__COUCHDB_URL=http://couchdb.local:5984
# PODAGENT_VAULT__DB=yourvault
# PODAGENT_VAULT__USER=podagent
# PODAGENT_VAULT_COUCHDB_PASSWORD=

# ----------------------------------------------------------------------------
# video-digest import (optional)
# ----------------------------------------------------------------------------
# Mirrors a sibling service's video summaries in as read-only episodes, so
# they can be read in this console with the same unread/starred marks. Nothing
# imported enters the pipeline, the weekly digest, or the vault — video-digest
# writes its own notes. See podcast_agent/ingest/video_digest.py.
#
# The key is video-digest's own admin key (its export is header-authenticated).
# PODAGENT_VIDEO_DIGEST__ENABLED=true
# PODAGENT_VIDEO_DIGEST__BASE_URL=http://video-digest.local:8090
# PODAGENT_VIDEO_DIGEST_API_KEY=

# ============================================================================
# Consumed by docker-compose
# ============================================================================

# CouchDB credentials. The username also goes in config.yaml (couchdb.user);
# the password is passed to the app as PODAGENT_COUCHDB_PASSWORD automatically.
COUCHDB_USER=podagent
COUCHDB_PASSWORD=

# Host path bind-mounted to /data/digests. On the NAS this is "./digests", so
# database, work dir and digests all sit under one folder a QNAP backup job can
# capture in a single pass (see DEPLOY-NAS.md).
DIGEST_DIR=./data/digests

# What the agent's port 80 is published as. A bare port answers on every
# interface; prefix an address to narrow it — "127.0.0.1:80" for this machine
# only, or a specific LAN address.
#
# On the NAS this is "127.0.0.1:80": the agent has no LAN address of its own
# any more (it joins homelab-internal and is reached through Traefik's
# podcast-digest.servers.zou route — see homelab-auth/README.md), and this
# publish exists only so the NAS host itself can reach the API.
AGENT_BIND=80
