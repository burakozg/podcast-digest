# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# All secrets are env-only — they must never appear in config.yaml (§8).

# ============================================================================
# Consumed by the application (PODAGENT_* prefix)
# ============================================================================

# --- Required ---------------------------------------------------------------
# Admin API key for every /api/v1 endpoint (X-API-Key header). Without it, those
# endpoints fail closed with 503 rather than opening up.
# Generate with: openssl rand -hex 32
PODAGENT_ADMIN_API_KEY=

# Both model providers in the shipped config.yaml: OpenRouter is the primary for
# every tier, Anthropic the fallback behind it. Both are REQUIRED while there is
# no local model host — startup refuses to boot rather than silently failing over
# to an unauthenticated provider.
#
# They stop being required only when a tier's active chain no longer contains
# that provider: restore an Ollama primary and set `allow_cloud_fallback: false`
# for a fully local deployment, and neither key is read.
PODAGENT_OPENROUTER_API_KEY=
PODAGENT_ANTHROPIC_API_KEY=

# --- Optional ---------------------------------------------------------------
# Only needed if notifications are enabled and your ntfy instance requires auth.
PODAGENT_NTFY_TOKEN=

# Path to the non-secret config file. The container sets this to
# /config/config.yaml; locally it defaults to ./config.yaml.
# PODAGENT_CONFIG_FILE=/config/config.yaml

# Any config.yaml value can be overridden with PODAGENT_<SECTION>__<KEY>:
# PODAGENT_PIPELINE__DIGEST_THRESHOLD=6
# PODAGENT_LOGGING__LEVEL=DEBUG

# Prefer an override here over editing the deployed config.yaml. Keeping that
# file byte-identical to the repo's is what stops it going quietly stale — the
# same failure scripts/make-local-config.py exists to prevent. The NAS uses this
# one, where large-v3-turbo does not fit alongside everything else on the box:
# PODAGENT_ASR__MODEL=small.en

# Where the weekly digest is read aloud, over the OpenAI speech API. This is
# deployment topology, so it lives here rather than in the console: on the Mac
# that is 127.0.0.1, from the NAS it is the Mac's LAN address. Setting it alone
# does nothing until text-to-speech is enabled on the Settings page.
# See RUNNING-ON-MAC.md for the Kokoro side.
# PODAGENT_TTS__BASE_URL=http://127.0.0.1:8880

# ============================================================================
# Consumed by docker-compose
# ============================================================================

# CouchDB credentials. The username also goes in config.yaml (couchdb.user);
# the password is passed to the app as PODAGENT_COUCHDB_PASSWORD automatically.
COUCHDB_USER=podagent
COUCHDB_PASSWORD=

# Host path bind-mounted to /data/digests. On the NAS this is "./digests", so
# database, work dir and digests all sit under one folder a QNAP backup job can
# capture in a single pass (see DEPLOY-NAS.md).
DIGEST_DIR=./data/digests

# What the agent's port 8080 is published as. A bare port answers on every
# interface; prefix an address to narrow it — "127.0.0.1:8080" for this machine
# only, or a specific LAN address.
#
# On the NAS this is "127.0.0.1:8080": the console's LAN address is its own
# qnet address (NAS_LAN_IP below), and this publish exists only so the NAS
# host can reach the API — which it cannot do over macvlan.
AGENT_BIND=8080

# docker-compose.nas.yml only: the container's static qnet IP (see
# DEPLOY-NAS.md). Compose auto-loads this file for ${...} substitution, so
# nothing besides this needs to change to point the NAS deploy at your own LAN.
NAS_LAN_IP=10.0.0.2
