# Copy to .deploy.env and fill in your real values. .deploy.env is git-ignored —
# never commit it. ./deploy and qnap/restore-nas.sh auto-source it, so these
# never need exporting by hand each session. See homelab/README.md for the
# contract these names follow.

# ssh destination for the NAS host itself — the account that owns NAS_APP_DIR.
NAS_SSH=deploy@nas.local
NAS_SSH_PORT=22

# No APP_LAN_IP here any more — the agent has no LAN address of its own. It
# joins homelab-internal (a plain bridge shared with Traefik) and is reached
# only through Traefik's podcast-digest.servers.zou route. See
# homelab-auth/README.md for the central-login project this is part of.

# Optional — only if your NAS directory or Container Station install differ from
# the defaults ./deploy assumes.
# NAS_APP_DIR=/share/Container/podcast-digest
# NAS_DOCKER_BIN=/share/CACHEDEV1_DATA/.qpkg/container-station/bin/docker
# NAS_PLATFORM=linux/amd64
